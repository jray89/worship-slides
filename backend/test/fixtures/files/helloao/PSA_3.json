{"translation":{"id":"eng_kjv","name":"King James (Authorized) Version","website":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-kjv2006","shortName":"KJAV","englishName":"King James Version","language":"eng","textDirection":"ltr","sha256":"a847712eeaae26124d3f9db80a1a9274742981261961b49715f43809774eb43c","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_kjv/books.json","completeTranslationApiLink":"/api/eng_kjv/complete.json","simpleCompleteTranslationApiLink":"/api/eng_kjv/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"eng_kjv","name":"Psalms","commonName":"Psalms","title":"The Book of Psalms","order":19,"numberOfChapters":150,"sha256":"7bccd076c8889684c0a037e3d255cb4508bb73e03494e49aa49156505c4e4bfd","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_kjv/PSA/1.json","firstChapterReference":{"translationId":"eng_kjv","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/eng_kjv/PSA/150.json","lastChapterReference":{"translationId":"eng_kjv","book":"PSA","chapter":150},"totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["A Psalm of David, when he fled from Absalom his son."]},{"type":"verse","number":1,"content":[{"text":"LORD, how are they increased that trouble me! many are they that rise up against me.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"Many there be which say of my soul, There is no help for him in God. Selah.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"But thou, O LORD, art a shield for me; my glory, and the lifter up of mine head.","poem":1},{"noteId":8}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"I cried unto the LORD with my voice, and he heard me out of his holy hill. Selah.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"I laid me down and slept; I awaked; for the LORD sustained me.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"I will not be afraid of ten thousands of people, that have set themselves against me round about.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"Arise, O LORD; save me, O my God: for thou hast smitten all mine enemies upon the cheek bone; thou hast broken the teeth of the ungodly.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"Salvation belongeth unto the LORD: thy blessing is upon thy people. Selah.","poem":1}]}],"footnotes":[{"noteId":8,"caller":"+","text":"3.3 for: or, about","reference":{"chapter":3,"verse":3}}]},"thisChapterLink":"/api/eng_kjv/PSA/3.json","thisChapterReference":{"translationId":"eng_kjv","book":"PSA","chapter":3},"thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_kjv/PSA/4.json","nextChapterReference":{"translationId":"eng_kjv","book":"PSA","chapter":4},"nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_kjv/PSA/2.json","previousChapterReference":{"translationId":"eng_kjv","book":"PSA","chapter":2},"previousChapterAudioLinks":{},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":8,"simpleChapterApiLink":"/api/eng_kjv/PSA/3.simple.json","thisChapterWordsLink":"/api/eng_kjv/PSA/3.words.json","previousChapterWordsLink":"/api/eng_kjv/PSA/2.words.json","nextChapterWordsLink":"/api/eng_kjv/PSA/4.words.json"}